NIFTY_CLIENT_ID=lpuxRCzhf9mFOpfUuzS7xNmfNKO5pq3F
NIFTY_CLIENT_SECRET=
NIFTY_AUTHORIZE_URL=https://nifty.pm/authorize?response_type=code&client_id=lpuxRCzhf9mFOpfUuzS7xNmfNKO5pq3F&redirect_uri=http://127.0.0.1:8787/callback&scope=file,doc,message,project,task,member,time_tracking,subteam,task_group,subtask,milestone,label
NIFTY_REDIRECT_URI=http://127.0.0.1:8787/callback

# Optional
NIFTY_AUTH_PORT=8787
NIFTY_DEFAULT_WORKFLOW=
NIFTY_ACCESS_TOKEN=
NIFTY_REFRESH_TOKEN=

# Automatic lifecycle policy (enabled by default)
NIFTY_AUTOPOLICY_ENABLED=true
NIFTY_AUTOPOLICY_ASSIGN_SELF=true
NIFTY_AUTOPOLICY_DEFAULT_ASSIGNEE_IDS=
NIFTY_AUTOPOLICY_IN_PROGRESS_STATE=in_progress
NIFTY_AUTOPOLICY_DEV_REVIEW_STATE=dev_review
NIFTY_AUTOPOLICY_ENFORCE_DELIVERY_GATE=true

# Automatic agent full-context hydration (enabled by default)
NIFTY_AUTOCONTEXT_ENABLED=true
NIFTY_AUTOCONTEXT_COMMENT_LIMIT=200
NIFTY_AUTOCONTEXT_TASK_LIMIT=200

# Mandatory context bootstrap gate (Phase 1 — direct-API precision hydration)
# When true, any mutating tool call (update, move, delete, complete) hard-fails
# if nifty_get_task_full_context / nifty_get_project_full_context has not been
# called for that entity in the current session. Disable only in legacy scripts.
NIFTY_BOOTSTRAP_REQUIRED=true

# Central policy-as-code enforcement (Phase 2 — deterministic governance)
# Point to a local or remote signed policy JSON document.
# NIFTY_POLICY_PATH=/path/to/policy/nifty-ai-policy.json
# NIFTY_POLICY_INLINE is reserved for CI / tests — do not set in production.

# RAG context injection (Phase 3 — probabilistic cross-org recall)
# Enabled by default. Tool calls remain fail-soft when LanceDB or indexes are
# unavailable; set false only when you explicitly want no historical context.
# Requires LanceDB index to be populated first:
#   npm run rag:index:policy   — indexes policy rules and ADR docs
#   npm run rag:index:tasks    — indexes Nifty task history and comments
# Index is kept fresh by the webhook server (npm run rag:webhook) which
# triggers incremental re-indexing on Nifty task.updated / comment.created events
# and runs a full re-sync nightly at midnight.
NIFTY_RAG_ENABLED=true
# Set true in managed production when task and policy tables must be present
# for health checks to report ok.
# NIFTY_RAG_REQUIRED=false
# NIFTY_RAG_INDEX_PATH=~/.config/opencode/nifty-rag
# NIFTY_RAG_TASK_LIMIT=5
# NIFTY_RAG_POLICY_LIMIT=3
# NIFTY_RAG_TIMEOUT_MS=2000
# NIFTY_RAG_CACHE_TTL_MS=300000
# NIFTY_RAG_QUERY_FANOUT=4
# NIFTY_RAG_MAX_QUERY_CHARS=700
# NIFTY_RAG_MAX_RESULT_TEXT_CHARS=1200
# NIFTY_RAG_API_TIMEOUT_MS=15000
# NIFTY_RAG_API_RETRIES=2
# NIFTY_RAG_API_RETRY_DELAY_MS=250

# RAG webhook server (incremental index freshness)
# Point your Nifty webhook to http://<host>:7779/webhook
# Set NIFTY_RAG_REINDEX_WEBHOOK_SECRET to the HMAC-SHA256 secret configured in
# your Nifty webhook settings. Omit to run in dev mode (no signature validation).
# NIFTY_RAG_WEBHOOK_PORT=7779
# NIFTY_RAG_REINDEX_WEBHOOK_SECRET=
# NIFTY_RAG_DEBOUNCE_MS=30000
# NIFTY_RAG_REINDEX_CRON=true

# Global report standard — lifecycle comment verbosity
# When false (default), suppresses the routine "Status set to In Progress"
# auto-lifecycle comment. The delivery gate structured report is never suppressed.
# Enable for verbose audit trails or regulated environments.
NIFTY_LIFECYCLE_STATUS_COMMENTS=false

# Autonomous task-card automation
# Policy controls parent completion, checklist-to-subtask creation, delivery docs,
# milestone comments, and Playwright visual proof capture. Use these env vars for
# local overrides only; keep shared defaults in policy/nifty-ai-policy.json.
# NIFTY_AUTOMATION_ACTIVE_TASK_ID=
# NIFTY_AUTOMATION_EDIT_TOOLS=apply_patch,write,edit,patch
# NIFTY_AUTOMATION_TEST_COMMAND_PATTERNS=npm test,pnpm test,yarn test,node --test,vitest,jest,playwright test
# NIFTY_AUTOMATION_PUSH_COMMAND_PATTERNS=git push
# NIFTY_AUTOMATION_PROGRESS_MAX_OUTPUT_CHARS=1000
# Completion is intentionally not autonomous while task chat may still be active.
# To close a task, the tool call must pass close_confirmation matching the policy
# template, for example: close MBC-462.
# NIFTY_AUTOMATION_PLAYWRIGHT_COMMAND=
# NIFTY_AUTOMATION_PLAYWRIGHT_PUBLISH_COMMAND=
# NIFTY_AUTOMATION_PLAYWRIGHT_OUTPUT_DIR=test-results
# NIFTY_AUTOMATION_PLAYWRIGHT_TIMEOUT_MS=300000

# MCP server configuration (used when running mcp/mcp-server.mjs)
# NIFTY_MCP_ROOT points to the root of the cloned repo. Required for
# nifty_update_plugin to also update mcp/mcp-server.mjs in MCP mode.
# Set automatically by install-copilot.sh, install-claude.sh, etc.
# NIFTY_MCP_ROOT=/absolute/path/to/opencode-plugin
# NIFTY_MCP_PLUGIN_CACHE_TTL_MS=300000    # how often policy is refreshed (default 5 min)
# NIFTY_MCP_DEBUG=                        # set to any value for JSON-structured debug logs on stderr
# NIFTY_MCP_ACTIVE_TASK_ID=                # optional hard override for startup progress target
# NIFTY_MCP_ACTIVE_TASK_STATE_PATH=        # default: ~/.local/state/nifty/mcp-active-task.json

# MCP autonomous progress observer
# MCP clients do not expose their native edit/test tools to the Nifty server.
# These settings let the MCP server autonomously poll git state after a task is
# observed, persist that task/worktree pairing across reloads, and post progress
# comments when meaningful worktree changes occur.
# NIFTY_MCP_PROGRESS_POLL_ENABLED=true
# NIFTY_MCP_PROGRESS_POLL_INTERVAL_MS=5000
# NIFTY_MCP_PROGRESS_IDLE_TTL_MS=1800000
# NIFTY_MCP_PROGRESS_TEST_COMMAND=         # optional; run after changed-worktree batches
# NIFTY_MCP_PROGRESS_TEST_TIMEOUT_MS=300000
